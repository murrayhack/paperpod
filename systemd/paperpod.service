[Unit]
Description=paperpod button daemon
# Mopidy serves both APIs this drives, so there is nothing to do until it is
# up. Not a hard dependency: the daemon retries and logs rather than dying, so
# a Mopidy restart does not take the buttons with it.
After=network-online.target mopidy.service
Wants=mopidy.service

[Service]
Type=simple
User=murray
# libgpiod opens /dev/gpiochip0 directly; on Raspberry Pi OS the gpio group
# already has access to it.
SupplementaryGroups=gpio
# Running from the checkout puts the package on sys.path, so this works
# whether or not paperpod has been pip-installed. Change it if you cloned
# somewhere else. Nothing needs a writable cwd any more -- that was lgpio's
# notification FIFO, and libgpiod has no such file.
WorkingDirectory=/home/murray/paperpod
ExecStart=/usr/bin/python3 -m paperpod.app --url http://localhost:6680
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
